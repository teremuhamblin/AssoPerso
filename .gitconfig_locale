# ============================================
#   .gitconfig (local au dépôt AssoPerso)
# ============================================

[core]
    editor = vim
    autocrlf = input

[color]
    ui = auto

[alias]
    st = status --short --branch
    lg = log --graph --decorate --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %C(green)%an%Creset %C(bold blue)%d%Creset %s' --date=short
    amend = commit --amend --no-edit
    unstage = reset HEAD --
    last = log -1 --stat

[commit]
    template = .gitedit

[merge]
    tool = vimdiff

# Spécifique au dépôt AssoPerso
[includeIf "gitdir:.git/"]
    path = .gitconfig-assoperso
